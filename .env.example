# Skopiuj ten plik do .env i uzupełnij wartości.
# Hash hasła wygenerujesz poleceniem: npm run hash-password

PORT=4173
NODE_ENV=development

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Losowy, długi ciąg znaków — użyj np. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=
