<!DOCTYPE html>
<html lang="pl">
<head>
<%- include('partials/head', { title: 'MISZA — Studio Fotografii Modowej', description: 'Misza — studio fotografii modowej, portretowej i editorial. Kadry, które zostają na dłużej.' }) %>
</head>
<body class="is-loading">
<%- include('partials/header', { active: 'home', onHome: true }) %>

<!-- ========== HERO SLIDER ========== -->
<section class="hero" id="hero">
  <canvas class="hero__smoke" id="heroSmokeCanvas"></canvas>
  <div class="hero__slides">
    <% content.hero.slides.forEach(function(slide, i) { %>
    <article class="slide<%= i === 0 ? ' is-active' : '' %>" data-slide>
      <div class="slide__media"><img src="<%= pic(slide.file, slide.variant) %>" alt="<%= slide.alt %>"></div>
      <div class="slide__copy">
        <p class="eyebrow" data-split><%= slide.eyebrow %></p>
        <h2 class="slide__title" data-split><%= slide.title %></h2>
        <a href="/gallery.html" class="btn-line magnetic"><span>Zobacz sesję</span><i></i></a>
      </div>
    </article>
    <% }); %>
  </div>

  <div class="hero__side">Wybrane prace</div>

  <div class="hero__nav">
    <button class="hero__arrow" data-dir="-1"><span>Prev</span></button>
    <div class="hero__count"><b id="slideNum">01</b><em></em><span id="slideTotal"><%= pad2(content.hero.slides.length) %></span></div>
    <button class="hero__arrow" data-dir="1"><span>Next</span></button>
  </div>

  <div class="hero__dots" id="heroDots"></div>
  <div class="hero__progress"><i id="heroProgress"></i></div>

  <a href="#about" class="hero__scroll"><span>Przewiń</span><i></i></a>
</section>

<!-- ========== MARQUEE ========== -->
<div class="marquee" aria-hidden="true">
  <div class="marquee__track" data-marquee>
    <span>Fotografia modowa <i>✦</i> Portret <i>✦</i> Editorial <i>✦</i> Beauty <i>✦</i> Lookbook <i>✦</i></span>
    <span>Fotografia modowa <i>✦</i> Portret <i>✦</i> Editorial <i>✦</i> Beauty <i>✦</i> Lookbook <i>✦</i></span>
  </div>
</div>

<!-- ========== ABOUT ========== -->
<% var mainImg = content.about.images.find(function(i){ return i.size === 'main'; }); %>
<% var smallImg = content.about.images.find(function(i){ return i.size === 'small'; }); %>
<section class="about section" id="about">
  <div class="wrap about__grid">

    <div class="about__media">
      <figure class="reveal-img" data-parallax="-60">
        <img src="<%= pic(mainImg.file, mainImg.variant) %>" alt="<%= mainImg.alt %>" loading="lazy">
      </figure>
      <figure class="reveal-img about__media--small" data-parallax="60">
        <img src="<%= pic(smallImg.file, smallImg.variant) %>" alt="<%= smallImg.alt %>" loading="lazy">
      </figure>
    </div>

    <div class="about__body">
      <p class="eyebrow" data-anim="fade"><%- eyebrowHtml(content.about.eyebrow) %></p>
      <h2 class="display" data-split><%= content.about.heading %></h2>
      <p class="lead" data-anim="fade">
        <%= content.about.text %>
      </p>

      <ul class="about__list" data-anim="stagger">
        <% content.about.stats.forEach(function(s) { %>
        <li><b><%= s.value %></b><span><%= s.label %></span></li>
        <% }); %>
      </ul>

      <a href="/gallery.html" class="btn-line magnetic"><span>Zobacz portfolio</span><i></i></a>
    </div>

  </div>
</section>

<!-- ========== HORIZONTAL SHOWCASE ========== -->
<section class="showcase" id="showcase">
  <div class="showcase__track" id="showcaseTrack">

    <div class="showcase__intro">
      <p class="eyebrow"><%- eyebrowHtml(content.showcase.eyebrow) %></p>
      <h2 class="display"><%- multilineHtml(content.showcase.heading) %></h2>
      <p class="lead"><%= content.showcase.lead %></p>
      <span class="showcase__hint"><i></i> przeciągnij lub scrolluj</span>
    </div>

    <% content.showcase.items.forEach(function(item, i) { %>
    <article class="show-item" data-index="<%= pad2(i + 1) %>">
      <a href="/gallery.html"
         class="show-item__media<%= item.hoverFile ? ' has-hover-effect' : '' %>"
         data-cursor="Zobacz"
         data-img1="<%= pic(item.file, item.variant || 'thumbs') %>"
         <% if (item.hoverFile) { %>data-img2="<%= pic(item.hoverFile, item.variant || 'thumbs') %>"<% } %>>
        <img src="<%= pic(item.file, item.variant || 'thumbs') %>" width="<%= item.width %>" height="<%= item.height %>" alt="<%= item.alt %>" loading="lazy">
      </a>
      <div class="show-item__meta"><h3><%= item.title %></h3><span><%= item.subtitle %></span></div>
    </article>
    <% }); %>

    <article class="show-item show-item--end">
      <a href="/gallery.html" class="show-item__all magnetic"><span>Cała<br>galeria</span><i></i></a>
    </article>

  </div>
</section>

<!-- ========== AKTUALNOŚCI ========== -->
<section class="news-home section" id="news">
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow" data-anim="fade">03 &nbsp;//&nbsp; Aktualności</p>
      <h2 class="display" data-split>Ze studia</h2>
    </header>

    <div class="news-grid" data-anim="stagger">
      <% latestNews.forEach(function(post) { %>
      <article class="news-card">
        <a class="news-card__media" href="/post.html?slug=<%= post.slug %>" data-cursor="Czytaj">
          <span class="news-card__cat"><%= post.category %></span>
          <img src="<%= pic(post.image, 'thumbs') %>" alt="<%= post.imageAlt %>" loading="lazy">
        </a>
        <div class="news-card__body">
          <span class="news-card__meta"><%= dateLabelPl(post.date) %><i></i><%= post.readTime %> czytania</span>
          <h3 class="news-card__title"><a href="/post.html?slug=<%= post.slug %>"><%= post.title %></a></h3>
          <p class="news-card__excerpt"><%= post.excerpt %></p>
          <a href="/post.html?slug=<%= post.slug %>" class="news-card__link"><span>Czytaj dalej</span><i></i></a>
        </div>
      </article>
      <% }); %>
    </div>

    <div class="news-home__foot">
      <a href="/aktualnosci.html" class="btn-line magnetic"><span>Wszystkie wpisy</span><i></i></a>
    </div>
  </div>
</section>

<!-- ========== SERVICES ========== -->
<section class="services section" id="services">
  <div class="wrap">
    <header class="section__head">
      <p class="eyebrow" data-anim="fade"><%- eyebrowHtml(content.services.eyebrow) %></p>
      <h2 class="display" data-split><%= content.services.heading %></h2>
    </header>

    <ul class="svc" id="svcList">
      <% content.services.items.forEach(function(item) { %>
      <li class="svc__row" data-img="<%= pic(item.file, item.variant) %>">
        <span class="svc__num"><%= item.number %></span>
        <h3 class="svc__title"><%= item.title %></h3>
        <span class="svc__tags"><%= item.tags %></span>
        <i class="svc__arrow"></i>
      </li>
      <% }); %>
    </ul>
  </div>

  <div class="svc__preview" id="svcPreview"><img src="" alt=""></div>
</section>

<!-- ========== CTA ========== -->
<section class="cta">
  <div class="cta__bg"><img src="<%= pic(content.cta.backgroundFile, content.cta.backgroundVariant) %>" alt="" loading="lazy"></div>
  <div class="wrap cta__inner">
    <p class="eyebrow" data-anim="fade"><%- eyebrowHtml(content.cta.eyebrow) %></p>
    <h2 class="display display--xl" data-split><%= content.cta.heading %></h2>
    <p class="lead" data-anim="fade"><%= content.cta.text %></p>
    <a href="mailto:<%= content.cta.email %>" class="btn-line btn-line--lg magnetic"><span><%= content.cta.email %></span><i></i></a>
  </div>
</section>

<!-- ========== INSTAGRAM ========== -->
<section class="insta">
  <p class="eyebrow insta__label" data-anim="fade">Obserwuj na Instagramie <b><%= content.instagram.handle %></b></p>
  <div class="insta__row">
    <% content.instagram.items.forEach(function(item) { %>
    <a href="<%= item.link %>" class="insta__item" data-cursor="Instagram"><img src="<%= pic(item.file, item.variant) %>" alt="" loading="lazy"></a>
    <% }); %>
  </div>
</section>

<!-- ========== KONTAKT ========== -->
<section class="contact section" id="contact">
  <div class="wrap contact__grid">
    <div class="contact__info">
      <p class="eyebrow" data-anim="fade"><%- eyebrowHtml(content.cta.eyebrow) %></p>
      <h2 class="display" data-split><%= content.cta.heading %></h2>
      <p class="lead" data-anim="fade"><%= content.cta.text %></p>

      <ul class="contact__details" data-anim="stagger">
        <li>
          <span>E-mail</span>
          <a href="mailto:<%= content.footer.email %>"><%= content.footer.email %></a>
        </li>
        <li>
          <span>Telefon</span>
          <a href="tel:<%= content.footer.phone.replace(/\s+/g, '') %>"><%= content.footer.phone %></a>
        </li>
        <li>
          <span>Studio</span>
          <span><%= content.footer.address %></span>
        </li>
      </ul>

      <div class="contact__social">
        <% content.footer.social.forEach(function(s) { %>
        <a href="<%= s.url %>"><%= s.label %></a>
        <% }); %>
      </div>
    </div>

    <form class="contact__form" id="contactForm" data-anim="fade" data-to="<%= content.footer.email %>">
      <div class="contact__form-row">
        <label><span>Imię i nazwisko</span><input type="text" name="name" required></label>
        <label><span>E-mail</span><input type="email" name="email" required></label>
      </div>
      <label><span>Temat</span><input type="text" name="subject" placeholder="Np. sesja portretowa"></label>
      <label><span>Wiadomość</span><textarea name="message" rows="5" required></textarea></label>
      <button type="submit" class="btn-line btn-line--lg magnetic"><span>Wyślij wiadomość</span><i></i></button>
    </form>
  </div>
</section>

<%- include('partials/footer', { footer: content.footer, onHome: true }) %>

<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.20/dist/lenis.min.js"></script>
<script src="/js/hover-effect.umd.js"></script>
<script src="/js/smokey-cursor.js"></script>
<script src="/js/app.js"></script>
<script src="/js/home.js"></script>
</body>
</html>
