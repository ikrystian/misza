<%- include('partials/shell-start', { title: 'Aktualności', username, active: 'news' }) %>

<header class="admin__head admin__head--row">
  <div>
    <h1>Aktualności</h1>
    <p>Zarządzaj wpisami aktualności.</p>
  </div>
  <a href="/admin/news/new" class="admin-btn">+ Dodaj wpis</a>
</header>

<% if (news.length) { %>
<table class="admin-table">
  <thead><tr><th>Tytuł</th><th>Kategoria</th><th>Data</th><th></th></tr></thead>
  <tbody>
    <% news.forEach(function(post) { %>
    <tr>
      <td><%= post.title %></td>
      <td><%= post.category %></td>
      <td><%= post.date %></td>
      <td class="admin-table__actions">
        <a href="/admin/news/<%= post.slug %>/edit">Edytuj</a>
        <button type="button" class="admin-link-btn admin-link-btn--danger" data-delete-slug="<%= post.slug %>">Usuń</button>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
<% } else { %>
<p class="admin-empty">Brak wpisów aktualności.</p>
<% } %>

<%- include('partials/shell-end') %>
